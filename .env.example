# mock: 无需API Key，本地演示动态Planner
# bailian: 使用阿里云百炼OpenAI Compatible API
LLM_PROVIDER=mock

BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen3.7-plus

APP_HOST=127.0.0.1
APP_PORT=8000

# 后端SSE事件节奏（仅mock模式生效）
STREAM_DEMO_DELAY_MS=160

# 前端事件队列逐条展示间隔；解决浏览器合并chunk后DOM一次性刷新的问题
UI_EVENT_DELAY_MS=180
