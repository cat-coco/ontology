  <rdf:Description rdf:about="https://example.com/ontology/financial-report-anomaly#Method_GovSubsidyFluctuation">
    <rdf:type rdf:resource="https://example.com/ontology/financial-report-anomaly#AnalysisMethod"/>
    <fra:code>METHOD_GOV_SUBSIDY_FLUCTUATION</fra:code>
    <fra:name>政府补助波动合理性分析方法</fra:name>
    <fra:description>领域方法不固化一条线性步骤，而是通过动态执行图定义允许的Skill路径和条件分支。</fra:description>
    <fra:drillsDownBy rdf:resource="https://example.com/ontology/financial-report-anomaly#Dimension_Entity"/>
    <fra:drillsDownBy rdf:resource="https://example.com/ontology/financial-report-anomaly#Dimension_ProfitCenter"/>
    <fra:drillsDownBy rdf:resource="https://example.com/ontology/financial-report-anomaly#Dimension_BusinessType"/>
    <fra:hasWorkflow rdf:resource="https://example.com/ontology/financial-report-anomaly#Workflow_GovSubsidyDynamic"/>
    <fra:implementedBySkill rdf:resource="https://example.com/ontology/financial-report-anomaly#Skill_FetchEFM"/>
    <fra:implementedBySkill rdf:resource="https://example.com/ontology/financial-report-anomaly#Skill_FetchDetail"/>
    <fra:implementedBySkill rdf:resource="https://example.com/ontology/financial-report-anomaly#Skill_RetrieveEvidence"/>
    <fra:implementedBySkill rdf:resource="https://example.com/ontology/financial-report-anomaly#Skill_RequestManualEvidence"/>
    <fra:implementedBySkill rdf:resource="https://example.com/ontology/financial-report-anomaly#Skill_GenerateConclusion"/>
  </rdf:Description>
