    <rdf:type rdf:resource="https://example.com/ontology/financial-report-anomaly#ThresholdRule"/>
    <fra:code>RULE_DCF0103_DETAIL_50</fra:code>
    <fra:name>DCF0103明细异常识别规则</fra:name>
    <fra:metric>detailChangeRate</fra:metric>
    <fra:operator>&gt;</fra:operator>
    <fra:thresholdValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.50</fra:thresholdValue>
    <fra:triggerAction>MARK_MAJOR_CONTRIBUTOR</fra:triggerAction>
    <fra:appliesToReportItem rdf:resource="https://example.com/ontology/financial-report-anomaly#ReportItem_DCF0103"/>
